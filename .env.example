# ---- Supabase ----
# Project URL and anon key (Project Settings -> API). Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key (Project Settings -> API). SERVER ONLY — never expose to the browser.
# Used by the verification worker to write results bypassing RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Anthropic ----
# Powers the match-verification engine (web search + web fetch + comparison).
ANTHROPIC_API_KEY=sk-ant-...

# ---- App ----
# Public base URL of the deployment (used for auth redirect callbacks).
# Locally this is http://localhost:3000 ; on Vercel set it to your domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# How many violations the verify worker processes per /api/.../verify call.
# Keep small on Vercel Hobby (60s function cap). Raise on Pro (300s).
VERIFY_BATCH_SIZE=3
