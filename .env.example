# ---- Supabase ----
# Project URL and anon key (Project Settings -> API). Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key (Project Settings -> API). SERVER ONLY — never expose to the browser.
# Used by the verification worker to write results bypassing RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Anthropic ----
# Powers the match-verification engine (web search + web fetch + comparison).
ANTHROPIC_API_KEY=sk-ant-...

# ---- App ----
# Public base URL of the deployment (used for auth redirect callbacks).
# Locally this is http://localhost:3000 ; on Vercel set it to your domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# How many violations the verify worker processes per /api/.../verify call.
# Keep small on Vercel Hobby (60s function cap). Raise on Pro (300s).
VERIFY_BATCH_SIZE=3

# ---- BrightData (optional) ----
# Web Unlocker token. When set, the verifier can fetch bot-walled seller pages
# (TikTok Shop, Walmart/Amazon marketplace, etc.) through BrightData instead of
# giving up. Leave unset to skip — those rows then come back NOT_FOUND with the
# seller link for manual review.
BRIGHTDATA_API_TOKEN=
# The Web Unlocker zone name from your BrightData dashboard (Proxies & Scraping
# Infrastructure -> your unlocker zone). Defaults to web_unlocker1.
BRIGHTDATA_ZONE=web_unlocker1

# ---- MPP deep link (optional) ----
# Base URL of the MPP admin app, used to build "View in MPP" links when the
# uploaded CSV includes a product-summary id column. Reviewers must already be
# signed in / impersonating in MPP for the link to resolve.
NEXT_PUBLIC_MPP_BASE_URL=https://app.mappolicypartners.com
